{
  "type": "object",
  "name": "Round",
  "properties": {
    "event_name": {
      "type": "string",
      "description": "Name of the event (tournament/competition name \u2014 shared across all flights in a multi-flight tournament)"
    },
    "flight_name": {
      "type": "string",
      "description": "Optional name for this specific flight (e.g. 'Championship Flight', 'President's Flight'). When set, displayed instead of the generic 'Flight N' label. The competition name (event_name) is inherited from the parent and shared across all flights."
    },
    "course_name": {
      "type": "string",
      "description": "Name of the golf course"
    },
    "date": {
      "type": "string",
      "description": "Date of the round",
      "format": "date"
    },
    "tee_set": {
      "type": "string",
      "description": "Tee set played"
    },
    "round_gender": {
      "type": "string",
      "description": "Default tee gender for the round",
      "enum": [
        "men's",
        "ladies'"
      ],
      "default": "men's"
    },
    "slope": {
      "type": "number",
      "description": "Slope rating for the selected tee set"
    },
    "rating": {
      "type": "number",
      "description": "Course rating for the selected tee set"
    },
    "course_tee_sets": {
      "type": "array",
      "description": "All tee sets available on the course (for per-player tee preference)",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "slope": {
            "type": "number"
          },
          "rating": {
            "type": "number"
          },
          "gender": {
            "type": "string",
            "enum": [
              "men's",
              "ladies'"
            ],
            "default": "men's"
          },
          "par": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "hole_handicap_indexes": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "ladies_hole_handicap_indexes": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "handicap_adjustment_mode": {
      "type": "boolean",
      "description": "If true, handicap index is converted to course handicap using slope/rating. If false, handicap is used as-is.",
      "default": true
    },
    "game_mode": {
      "type": "string",
      "description": "Game mode",
      "enum": [
        "SWIFT_SCORE_11",
        "CUSTOM",
        "OFF"
      ]
    },
    "buy_in": {
      "type": "number",
      "description": "Buy-in amount per player (main pot). For multi-day series rounds, this is the total series entry fee per player."
    },
    "added_money": {
      "type": "number",
      "description": "Lump sum of added money (sponsorship, added purse, etc.) folded into the main gross/net pot alongside player buy-ins. For multi-flight tournaments, splits across flights proportionally by player count.",
      "default": 0
    },
    "added_money_label": {
      "type": "string",
      "description": "Optional label for the added money (e.g. 'Sponsorship', 'Added Purse'). Shown in the pot breakdown on the results page."
    },
    "is_multi_day": {
      "type": "boolean",
      "description": "If true, this round is part of a multi-day or multi-flight tournament series. The buy-in represents the total series entry fee (held until final round), while side games (skins, KPs, deuces) are settled round-by-round.",
      "default": false
    },
    "parent_round_id": {
      "type": "string",
      "description": "For series child rounds (Day/Flight 2+): the ID of the parent (Day/Flight 1) round that anchors the series. Null for standalone rounds and for the parent round itself."
    },
    "is_series_final": {
      "type": "boolean",
      "description": "Series: explicitly marks this child round as the final day of the series. When true (and, for hybrid tournaments, is_final_flight is also true), the main gross/net purse is distributed from cumulative/field standings. When false (default), the main purse is held \u2014 side games (skins, KPs, deuces) settle round-by-round. If unset, final-day status is inferred from dates (latest-dated child).",
      "default": false
    },
    "is_final_flight": {
      "type": "boolean",
      "description": "Hybrid multi-day + multi-flight only: explicitly marks this round as belonging to the final flight of the series. The main purse pays out only when BOTH is_final_flight and is_series_final are true (final day of the final flight). If unset, auto-detected from flight_number (highest = final flight).",
      "default": false
    },
    "series_type": {
      "type": "string",
      "description": "Series type: 'multi_day' (same players across multiple days, scores summed for cumulative standings) or 'multi_flight' (different players per flight, field standings rank all players together for Low Gross/Net of the Field). Only meaningful when is_multi_day is true.",
      "enum": [
        "multi_day",
        "multi_flight"
      ],
      "default": "multi_day"
    },
    "is_multi_flight": {
      "type": "boolean",
      "description": "If true, this tournament has different player pools per flight. Independent of the multi-day toggle \u2014 both can be enabled simultaneously for a multi-flight tournament that spans multiple days. When true, series_type is set to 'multi_flight' and is_multi_day is also true.",
      "default": false
    },
    "flight_number": {
      "type": "number",
      "description": "Hybrid multi-day + multi-flight: identifies which flight this round belongs to (1, 2, 3\u2026). Flight 1 / Day 1 is the parent (flight_number=1). When adding a new day to an existing flight, the flight_number matches that flight. When adding a new flight, flight_number is the next available. Only meaningful when both is_multi_day and is_multi_flight are true.",
      "default": 1
    },
    "champion_enabled": {
      "type": "boolean",
      "description": "Per-tournament opt-in for champion / playoff declaration, configured in Tournament Logistics. When true, the host can name a playoff winner for a flight/division that ties for first, and a champion statement appears on the results page, results email, printed PDF and public results link.",
      "default": false
    },
    "champion_payout_mode": {
      "type": "string",
      "description": "What declaring a playoff winner does to the money. 'title_only' (the standard for all new rounds) leaves payouts untouched and only records the champion label. 'winner_take_all' is LEGACY ONLY \u2014 kept so rounds recorded with it never change; it is never offered or set for new rounds.",
      "enum": [
        "title_only",
        "winner_take_all"
      ],
      "default": "title_only"
    },
    "champion_divisions": {
      "type": "array",
      "description": "Which divisions crown a champion: 'gross', 'net', or both. Missing/empty means gross only (the original behaviour).",
      "default": [
        "gross"
      ],
      "items": {
        "type": "string",
        "enum": [
          "gross",
          "net"
        ]
      }
    },
    "champion_purse_per_flight": {
      "type": "object",
      "description": "Separate Champion Purse (club/sponsor money) per flight, keyed by flight number: { \"1\": { \"gross\": 200, \"net\": 100 } }. Paid to each division champion on top of the place payouts \u2014 never taken from the buy-in pot or any place payout.",
      "default": {}
    },
    "flight_champions": {
      "type": "array",
      "description": "Declared playoff champions, one entry per flight per division. Written to every round in the series when declared so all result surfaces read the same answer. A champion is ignored (and not displayed) if a later score edit means that player no longer holds or shares the lead in that division.",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "flight_number": {
            "type": "number",
            "description": "Which flight this champion won (1, 2, 3\u2026)"
          },
          "division": {
            "type": "string",
            "description": "Which division this champion won. Missing means gross (entries declared before net champions existed).",
            "enum": [
              "gross",
              "net"
            ],
            "default": "gross"
          },
          "player_id": {
            "type": "string",
            "description": "The declared champion's player_id"
          },
          "player_name": {
            "type": "string",
            "description": "Champion's name at the time of declaration (display fallback)"
          },
          "via_playoff": {
            "type": "boolean",
            "description": "True when the champion was picked from a tie (a playoff decided it), false when they led outright",
            "default": false
          },
          "declared_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the champion was declared"
          }
        }
      }
    },
    "player_count": {
      "type": "number",
      "description": "Number of players"
    },
    "par": {
      "type": "array",
      "description": "Par for each of 18 holes",
      "items": {
        "type": "number"
      }
    },
    "hole_handicap_indexes": {
      "type": "array",
      "description": "Men's handicap index for each of 18 holes",
      "items": {
        "type": "number"
      }
    },
    "ladies_hole_handicap_indexes": {
      "type": "array",
      "description": "Ladies' handicap index for each of 18 holes",
      "items": {
        "type": "number"
      }
    },
    "team_mode": {
      "type": "boolean",
      "description": "If true, scorecard renders team format with Gross and Net best-ball rows",
      "default": false
    },
    "team_size": {
      "type": "number",
      "description": "Number of players per team (2, 3, or 4) \u2014 used for team format scorecards. Las Vegas (1 gross / 2 net) requires 3 or 4.",
      "enum": [
        2,
        3,
        4
      ],
      "default": 2
    },
    "team_format": {
      "type": "string",
      "description": "Team scorecard format: best_ball (individual rows + Gross/Net best-ball), scramble (one team score per hole), aggregate (sum of all team scores per hole), or las_vegas (optimized 1 gross + 2 net per hole)",
      "enum": [
        "best_ball",
        "scramble",
        "aggregate",
        "las_vegas"
      ],
      "default": "best_ball"
    },
    "segments_666": {
      "type": "array",
      "description": "6-6-6 format: one entry per 6-hole segment with its scoring format",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "holes": {
            "type": "string",
            "description": "Label for the hole range (e.g. 'Holes 1\u20136')"
          },
          "format": {
            "type": "string",
            "description": "Scoring format for this segment",
            "enum": [
              "chapman",
              "best_ball",
              "scramble",
              "alternate_shot",
              "aggregate"
            ]
          }
        }
      }
    },
    "game_type": {
      "type": "string",
      "description": "Game type: individual (standard play) or team-based formats (scramble, best ball, 6-6-6, chapman, aggregate, las vegas 1-gross/2-net)",
      "enum": [
        "individual",
        "team_scramble",
        "team_best_ball",
        "team_6_6_6",
        "team_chapman",
        "team_aggregate",
        "team_las_vegas"
      ],
      "default": "individual"
    },
    "hcp_formula": {
      "type": "string",
      "description": "Team handicap formula: none (no handicap), individual (per-player handicap, no team adjustment), combined_avg, avg_30 (70% of combined average), combined_85 (85% of combined), usga_scramble (25% low / 15% high), split_60_40 (60% low / 40% high), split_35_15 (35% low / 15% high), or sum (full combined)",
      "enum": [
        "none",
        "individual",
        "combined_avg",
        "avg_30",
        "combined_85",
        "usga_scramble",
        "split_60_40",
        "split_35_15",
        "sum"
      ],
      "default": "combined_85"
    },
    "vegas_hcp_percent": {
      "type": "number",
      "description": "Las Vegas only: custom handicap allowance percentage (0\u2013200) applied to every player's course handicap for the whole round \u2014 scorecard dots, team Gross/Net rows, and individual net side games. When unset, the allowance is derived from hcp_formula (85% of Combined \u2192 85%, 70% of Combined Average \u2192 70%, No Handicap \u2192 0%, anything else \u2192 100%)."
    },
    "games": {
      "type": "array",
      "description": "Multi-game configuration: each game is computed independently (main event + side games)",
      "default": [],
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "format"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for this game within the round"
          },
          "name": {
            "type": "string",
            "description": "Display name (e.g. 'Main Event', 'Individual Side Pot')"
          },
          "type": {
            "type": "string",
            "description": "Whether standings/payouts are computed per-player or per-team",
            "enum": [
              "individual",
              "team"
            ],
            "default": "individual"
          },
          "format": {
            "type": "string",
            "description": "Scoring format for this game",
            "enum": [
              "stroke_play",
              "best_ball",
              "scramble",
              "chapman",
              "6_6_6",
              "aggregate",
              "stableford",
              "las_vegas"
            ],
            "default": "stroke_play"
          },
          "buy_in": {
            "type": "number",
            "description": "Per-player buy-in for this game's purse",
            "default": 0
          },
          "is_main": {
            "type": "boolean",
            "description": "True for the primary game (drives scorecard layout and team roster)",
            "default": false
          },
          "team_size": {
            "type": "number",
            "description": "Team size for this game (only if type='team')",
            "enum": [
              2,
              3,
              4
            ]
          },
          "hcp_formula": {
            "type": "string",
            "description": "Team handicap formula for this game (only if type='team')",
            "enum": [
              "none",
              "individual",
              "combined_avg",
              "avg_30",
              "combined_85",
              "usga_scramble",
              "split_60_40",
              "split_35_15",
              "sum"
            ]
          },
          "payout_percent": {
            "type": "number",
            "description": "Percentage of this game's purse paid to top finishers"
          },
          "places_paid": {
            "type": "number",
            "description": "Number of payout positions for this game",
            "default": 3
          }
        }
      }
    },
    "players": {
      "type": "array",
      "description": "Player roster with scores",
      "items": {
        "type": "object",
        "properties": {
          "player_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "handicap": {
            "type": "number"
          },
          "is_plus_handicap": {
            "type": "boolean",
            "default": false
          },
          "course_handicap": {
            "type": "number"
          },
          "tee_preference": {
            "type": "string"
          },
          "tee_gender_preference": {
            "type": "string",
            "enum": [
              "men's",
              "ladies'"
            ]
          },
          "tee_time": {
            "type": "string",
            "description": "Assigned tee time (HH:MM)"
          },
          "tee_group": {
            "type": "string",
            "description": "Optional group tag for 'Group Priority' auto-assignment"
          },
          "scores": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "tee_sheet_config": {
      "type": "object",
      "description": "Tee sheet configuration for this round",
      "properties": {
        "start_time": {
          "type": "string",
          "description": "First tee time (HH:MM)"
        },
        "interval_minutes": {
          "type": "number",
          "default": 8
        },
        "group_size": {
          "type": "number",
          "default": 4
        },
        "extra_slots": {
          "type": "number",
          "description": "Additional empty tee time slots beyond the player count",
          "default": 0
        }
      }
    },
    "kps_enabled": {
      "type": "boolean",
      "default": false
    },
    "kp_holes": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "kp_winners": {
      "type": "array",
      "description": "KP winner player_ids per hole",
      "items": {
        "type": "object",
        "properties": {
          "hole": {
            "type": "number"
          },
          "player_id": {
            "type": "string"
          }
        }
      }
    },
    "kp_separate_buy_in": {
      "type": "boolean",
      "default": false
    },
    "kp_buy_in": {
      "type": "number",
      "default": 5
    },
    "kp_player_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kp_counts_as_skin": {
      "type": "boolean",
      "default": false
    },
    "gross_skins_enabled": {
      "type": "boolean",
      "default": false
    },
    "gross_skins_separate_buy_in": {
      "type": "boolean",
      "default": false
    },
    "gross_skins_buy_in": {
      "type": "number",
      "default": 5
    },
    "gross_skins_player_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "net_skins_enabled": {
      "type": "boolean",
      "default": false
    },
    "net_skins_separate_buy_in": {
      "type": "boolean",
      "default": false
    },
    "net_skins_buy_in": {
      "type": "number",
      "default": 5
    },
    "net_skins_player_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skins_carryover": {
      "type": "boolean",
      "default": false
    },
    "skins_team_mode": {
      "type": "boolean",
      "description": "In team-format rounds, skins default to team-level (team best-ball per hole, winnings split among members). Set to false to keep skins individual per-player even in a team event.",
      "default": true
    },
    "deuce_pot_enabled": {
      "type": "boolean",
      "default": false
    },
    "deuce_buy_in": {
      "type": "number",
      "default": 5
    },
    "deuce_player_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "custom_place_payout_percent": {
      "type": "number"
    },
    "custom_games_percent": {
      "type": "number"
    },
    "custom_gross_percent": {
      "type": "number"
    },
    "custom_net_percent": {
      "type": "number"
    },
    "custom_gross_field_percent": {
      "type": "number"
    },
    "custom_net_field_percent": {
      "type": "number"
    },
    "custom_gross_places": {
      "type": "number"
    },
    "custom_net_places": {
      "type": "number"
    },
    "field_prizes_enabled": {
      "type": "boolean",
      "description": "Multi-flight only: if true, Low Gross of the Field and Low Net of the Field prizes are calculated as a percentage of their respective gross/net pots and awarded to the overall best players across all flights. Set on the parent (Flight 1) round.",
      "default": false
    },
    "field_gross_percent": {
      "type": "number",
      "description": "Multi-flight only: percentage of the combined gross pot (across all flights) awarded to Low Gross of the Field. Only used when field_prizes_enabled is true.",
      "default": 22
    },
    "field_net_percent": {
      "type": "number",
      "description": "Multi-flight only: percentage of the combined net pot (across all flights) awarded to Low Net of the Field. Only used when field_prizes_enabled is true.",
      "default": 22
    },
    "field_gross_prize": {
      "type": "number",
      "description": "Legacy: fixed dollar amount for Low Gross of the Field. Superseded by field_gross_percent when field_prizes_enabled is true.",
      "default": 0
    },
    "field_net_prize": {
      "type": "number",
      "description": "Legacy: fixed dollar amount for Low Net of the Field. Superseded by field_net_percent when field_prizes_enabled is true.",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "setup",
        "roster",
        "scoring",
        "completed"
      ],
      "default": "setup"
    },
    "results": {
      "type": "object",
      "description": "Computed results JSON"
    },
    "is_public": {
      "type": "boolean",
      "description": "If true, this round's results can be viewed via public link",
      "default": false
    },
    "locked_format": {
      "type": "object",
      "description": "Locked scorecard format snapshot (header, par, hcp) to prevent changes",
      "properties": {
        "header_text": {
          "type": "string",
          "description": "Locked header text for scorecard PDF"
        },
        "par": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "hole_handicap_indexes": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "scorecard_pdf_url": {
      "type": "string",
      "description": "URL of the most recently generated scorecard PDF (overwritten each generation)"
    },
    "results_pdf_url": {
      "type": "string",
      "description": "Cached results PDF URL \u2014 first successful generation is returned on repeated presses; cleared when results are recomputed"
    }
  },
  "required": [
    "event_name",
    "game_mode",
    "buy_in",
    "player_count"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.is_public": true
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}